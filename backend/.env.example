# Copy this file to .env and fill in the values. .env is git-ignored.

# PostgreSQL connection (tables are created in the "backlogd" schema automatically)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=

# Base64 secret (32+ bytes) used to sign login tokens.
# Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
