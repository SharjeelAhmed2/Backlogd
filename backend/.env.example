# Copy this file to .env and fill in the values. .env is git-ignored.

# PostgreSQL connection (tables are created in the "backlogd" schema automatically)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=

# Base64 secret (32+ bytes) used to sign login tokens.
# Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Film search - https://www.themoviedb.org/settings/api (API Key or API Read Access Token)
TMDB_API_KEY=

# MyAnimeList import - https://myanimelist.net/apiconfig (Client ID)
MAL_CLIENT_ID=
